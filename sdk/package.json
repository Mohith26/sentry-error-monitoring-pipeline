{
  "name": "@sentinel/sdk",
  "version": "1.0.0",
  "description": "Mini-Sentry TypeScript SDK: capture uncaught exceptions + captureException with normalized stack traces and ship an event envelope to the ingest API.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "node dist/demo/demo.js",
    "bench": "node dist/bench/capture_overhead.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
